+        "turn_id": agent._persona_chat_turn_id,
+    })
+    record_wire_boundary_drift(bound)
+    msg.clear()
+    msg.update(bound.row)
+    platform_id = agent._persona_chat_client_message_id
+    role = msg.get("role", "unknown")
+    if role != "user":

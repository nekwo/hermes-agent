+    """Return named profile templates without gateway or skill-count probes."""
+    profiles: list[ProfileTemplateInfo] = []
+    try:
+        profiles_root = _get_profiles_root()
+        entries = sorted(profiles_root.iterdir()) if profiles_root.is_dir() else []

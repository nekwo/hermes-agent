+        (os.pardir, "bin", "bash.exe"),
+        (os.pardir, "usr", "bin", "bash.exe"),
+        (os.pardir, os.pardir, "bin", "bash.exe"),
+        (os.pardir, os.pardir, "usr", "bin", "bash.exe"),
+    ):

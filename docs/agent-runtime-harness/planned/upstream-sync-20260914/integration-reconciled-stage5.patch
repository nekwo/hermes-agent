+            )
+        except Exception:
+            continue
+
+    return profiles
+
+def _mark_profile_personas_orphaned(profile_name: str) -> None:
+    try:
+        from agent_runtime.store import AgentStore
+    except Exception:
+        return
+    store = AgentStore()
+    try:
+        personas = store.list_all()
+    except Exception:
